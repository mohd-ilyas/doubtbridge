{
  "name": "doubtbridge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --config backend/jest.config.js",
    "dev": "nodemon backend/src/index.ts",
    "start": "npm run start:backend",
    "type-check": "tsc --noEmit -p backend/tsconfig.json",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema backend/prisma/schema.postgresql.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.postgresql.prisma",
    "db:seed": "ts-node backend/prisma/seed.ts",
    "db:seed:postgres": "prisma db seed --schema backend/prisma/schema.postgresql.prisma",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start:backend": "node backend/dist/index.js",
    "start:production": "npm run db:migrate:deploy && npm run db:seed:postgres && npm run start:backend"
  },
  "prisma": {
    "seed": "ts-node backend/prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.1",
    "jest-mock-extended": "^4.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "prisma": "^5.10.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  }
}
